{
  "name": "@cafein-network/wax",
  "version": "0.12.7",
  "description": "A portable, evidence-based AI coding workflow and team dashboard for Claude Code, Codex, GitHub Copilot CLI, Gemini CLI and Antigravity CLI",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wax": "./bin/wax.mjs"
  },
  "exports": {
    ".": "./src/workflow.mjs",
    "./backup": "./src/backup.mjs",
    "./evidence": "./src/evidence.mjs",
    "./lock": "./src/file-lock.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "claude-mods",
    "hooks",
    "commands",
    "skills",
    "scripts/install-codex.mjs",
    "scripts/verify-windows.mjs",
    "docs",
    ".codex-plugin",
    ".claude-plugin",
    "gemini-extension.json",
    "GEMINI.md",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000",
    "dashboard": "node bin/wax.mjs dashboard",
    "build": "node scripts/build-commands.mjs && node scripts/build-faces.mjs",
    "check": "node scripts/build-commands.mjs --check && node scripts/build-faces.mjs --check",
    "package": "python3 scripts/package-release.py",
    "test:package": "python3 test/package_test.py",
    "test:windows": "node scripts/verify-windows.mjs"
  }
}
