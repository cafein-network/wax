{
  "schema": 1,
  "tool": "codex",
  "version": "2026.11.01",
  "rules": [
    {
      "id": "model-not-found",
      "shape": "config",
      "match": { "stream": "error", "contains": ["\"code\":\"model_not_found\""] }
    },
    {
      "id": "usage-limit",
      "shape": "quota",
      "match": { "stream": "error", "regex": "hit your usage limit" },
      "until": { "regex": "try again at ([A-Za-z]{3,9} \\d{1,2}(?:st|nd|rd|th)?, \\d{4},? \\d{1,2}:\\d{2} ?[AP]M)" }
    }
  ]
}
